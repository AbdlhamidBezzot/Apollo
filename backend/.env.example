# --- Apollo Backend configuration ---
# Copy to `.env` and fill in. Never commit the real .env.

# App
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# JWT signing secret (JWT_SECRET overrides SECRET_KEY when set)
JWT_SECRET=
# Comma-separated allowed origins for the browser app
CORS_ORIGINS=http://localhost:3000

# Database.
# Default (no Postgres running): use SQLite for local dev:
DATABASE_URL=sqlite:///./apollo.db
# For full Postgres (docker-compose up -d postgres), use:
DATABASE_URL=postgresql+psycopg://apollo:YPoDBI5XWDQTG3QHhIcb3Y7f@localhost:5432/apollo

# Redis (optional in dev). If unreachable, the app falls back to in-memory cache/limits.
REDIS_URL=redis://localhost:6379/0

# TMDB (metadata only). Required for real content.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Playback provider.
# Playback is pluggable (see backend/app/services/playback/).
# vidsrc-embed.ru iframe embed (movies/series/episodes by TMDB id):
PLAYBACK_PROVIDER=vidsrc

# Auth
# OAuth provider stubs â€” fill in for Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Access/refresh token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# JWT_* names override the above when set.
JWT_ACCESS_TOKEN_EXPIRES_MIN=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Rate limiting (requests per window)
RATE_LIMIT_LOGIN=5/15minute
RATE_LIMIT_GENERAL=120/minute
RATE_LIMIT_CHAT=20/hour

# Gemini API. Create a key in Google AI Studio; it stays server-side.
# Gemini Flash is used for quick conversational responses and grounded picks.
GEMINI_API_KEY="AQ.Ab8RN6JC4IMeeXTp6CRylz2OyUGrQjTgkaX2p4heijAnvTsBwQ"
GEMINI_MODEL=gemini-2.5-flash
