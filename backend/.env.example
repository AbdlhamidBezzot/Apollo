# --- Apollo Backend configuration ---
# Copy to `.env` and fill in. Never commit the real .env.
#
# All values here are placeholders/development defaults. Production values are
# injected by your host (Render/Railway/Fly/Vercel) via environment variables —
# nothing here should point at localhost in a deployed environment.

# App
APP_ENV=development            # development | test | production
SECRET_KEY=change-me-to-a-long-random-string
# JWT signing secret (JWT_SECRET overrides SECRET_KEY when set)
JWT_SECRET=
# Comma-separated allowed browser origins (credentials are enabled -> NO wildcard).
# Development:
#   http://localhost:3000,http://localhost:5173
# Production example:
#   https://apollo-94zv.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://apollo-94zv.vercel.app

# Cross-site cookie policy for development only. Production always forces
# SameSite=None + Secure (required because the Vercel frontend and Render API are
# cross-site), so this value only affects same-origin local development.
COOKIE_SAMESITE=lax

# Database. Production MUST be PostgreSQL (never sqlite).
# Railway / Render / Fly: use the platform's DATABASE_URL (postgresql://...).
DATABASE_URL=sqlite:///./apollo.db
# Example Postgres (docker-compose up -d postgres):
# DATABASE_URL=postgresql+psycopg://apollo:PASSWORD@localhost:5432/apollo

# Redis. On dev this may be unreachable (app falls back to in-memory cache/limits).
# In production REDIS_URL is REQUIRED and must be reachable — the app fails fast if it is not.
REDIS_URL=redis://localhost:6379/0

# TMDB (metadata only). Required for real content.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Playback provider (pluggable, see app/services/playback/).
PLAYBACK_PROVIDER=vidsrc

# Access/refresh token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_ACCESS_TOKEN_EXPIRES_MIN=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Rate limiting (requests per window; token buckets allow short bursts up to this).
# Request identity: authenticated user ID when possible, else client IP.
RATE_LIMIT_LOGIN=5/15minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_CHAT=20/hour
RATE_LIMIT_CHAT_STREAM=60/hour
RATE_LIMIT_READ=3000/minute
RATE_LIMIT_SEARCH=3000/minute
RATE_LIMIT_DISCOVER=300/minute
RATE_LIMIT_ME=180/minute
RATE_LIMIT_PLAY=120/minute
RATE_LIMIT_PLAYBACK=120/minute
# Read the client IP from X-Forwarded-For. Enable ONLY behind a trustable proxy
# (Render, Railway, nginx, etc.). Keep false for direct public exposure.
RATE_LIMIT_TRUST_FORWARDED=false

# LLM provider for CineBot
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Option B: DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# LLM_API_KEY=             # shared alias used by the backend when set