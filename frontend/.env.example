# --- Apollo Frontend configuration ---
# Vercel: set these in the Vercel project (Settings -> Environment Variables),
# NOT committed. `.env.local` is only for local development.
#
# NEVER point this at localhost in a production/Vercel deployment.

# Your deployed backend (no trailing slash), e.g.
#   https://your-api.onrender.com     (Render)
#   https://your-api.up.railway.app   (Railway)
#   https://your-api.fly.dev          (Fly.io)
NEXT_PUBLIC_API_URL=http://localhost:8000

# TMDB image CDN (safe to expose - no keys involved).
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p