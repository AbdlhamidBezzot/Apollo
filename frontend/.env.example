# --- Apollo Frontend configuration ---
# Copy to `.env.local` and fill in. Never commit the real file.

# Your own backend. All TMDB/playback keys stay server-side.
NEXT_PUBLIC_API_URL=http://localhost:8000

# TMDB image CDN (safe to expose — no keys involved).
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
